pageType: content
background: {type: solid, color: "$paper"}
elements:
  - elementId: section
    elementType: text
    bounds: [48, 18, 420, 18]
    content: {fontSize: 10, color: "$orange", bold: true, letterSpacing: 1.2, wrap: false, text: "06 / SENSITIVITY + VALIDITY"}
  - elementId: timing
    elementType: text
    bounds: [850, 18, 62, 18]
    content: {fontSize: 11, color: "$grey", bold: true, align: [right, middle], wrap: false, text: "1:00"}
  - elementId: title
    elementType: text
    bounds: [48, 43, 860, 43]
    content: {style: "$title", fontSize: 30, wrap: false, text: "Threshold sensitivity and execution limits weaken the profit claim"}
  - {elementId: header-rule, elementType: shape, bounds: [48, 96, 864, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: sensitivity-chart
    elementType: image
    bounds: [48, 116, 602, 351]
    src: "media/betting_sensitivity.png"
    fit: {mode: contain}
  - elementId: sensitivity-label
    elementType: text
    bounds: [690, 122, 222, 20]
    content: {fontSize: 11, color: "$orange", bold: true, letterSpacing: 1, wrap: false, text: "ROI IS NON-MONOTONIC"}
  - elementId: sensitivity-values
    elementType: text
    bounds: [690, 153, 222, 137]
    content:
      fontSize: 14
      color: "$ink"
      lineHeight: 1.35
      text: |
        <p><strong>0% edge / cap 30</strong> · −8.7%</p>
        <p><span style="color:$grey">269 bets</span></p>
        <p style="margin-top:5px"><strong>5% / cap 30</strong> · +7.2%</p>
        <p><span style="color:$grey">127 bets</span></p>
        <p style="margin-top:5px"><strong>10% / cap 30</strong> · +65.9%</p>
        <p><span style="color:$grey">only 48 bets</span></p>
  - elementId: extreme-values
    elementType: text
    bounds: [690, 297, 222, 48]
    content:
      fontSize: 14
      color: "$ink"
      lineHeight: 1.3
      text: |
        <p><strong>20% edge:</strong> four bets, all lose</p>
        <p><strong>30% edge:</strong> no qualifying bets</p>
  - {elementId: limits-rule, elementType: shape, bounds: [690, 359, 222, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: limits-label
    elementType: text
    bounds: [690, 375, 222, 20]
    content: {fontSize: 11, color: "$orange", bold: true, letterSpacing: 1, wrap: false, text: "STILL UNRESOLVED"}
  - elementId: limits
    elementType: text
    bounds: [690, 404, 222, 68]
    content:
      fontSize: 14
      color: "$ink"
      lineHeight: 1.3
      text: "Executable prices, timestamped information, temporal stability, left-censored histories, and omitted handicapping data."
  - {elementId: footer-rule, elementType: shape, bounds: [48, 499, 864, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: source
    elementType: text
    bounds: [48, 507, 790, 18]
    content: {style: "$source", wrap: false, text: "Source: betting_sensitivity.csv and report Section 6. Test grid is exploratory; all odds bands have negative unconditional ROI."}
  - elementId: page-no
    elementType: text
    bounds: [874, 506, 38, 18]
    content: {fontSize: 10, color: "$grey", align: [right, middle], wrap: false, text: "09 / 14"}
