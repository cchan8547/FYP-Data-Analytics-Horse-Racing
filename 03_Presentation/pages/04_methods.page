  - elementId: candidates
    elementType: text
    bounds: [580, 153, 332, 202]
    content:
      fontSize: 15
      color: "$ink"
      lineHeight: 1.28
      text: |
        <p><strong>Fundamental Logit</strong> · histories + race covariates; no odds</p>
        <p style="margin-top:9px"><strong>Fundamental LightGBM</strong> · same information; nonlinear comparator</p>
        <p style="margin-top:9px"><strong>Combined Logit</strong> · fundamentals + log market probability</p>
        <p style="margin-top:9px"><strong>Combined LightGBM</strong> · also odds, market rank, overround</p>
