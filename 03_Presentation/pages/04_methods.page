pageType: content
background: {type: solid, color: "$paper"}
elements:
  - elementId: section
    elementType: text
    bounds: [48, 18, 420, 18]
    content: {fontSize: 10, color: "$teal", bold: true, letterSpacing: 1.2, wrap: false, text: "03 / RACE-WISE MODELING"}
  - elementId: timing
    elementType: text
    bounds: [850, 18, 62, 18]
