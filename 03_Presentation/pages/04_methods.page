  - elementId: title
    elementType: text
    bounds: [48, 43, 850, 43]
    content: {style: "$title", fontSize: 31, wrap: false, text: "One race, one probability vector—not independent binary labels"}
  - {elementId: header-rule, elementType: shape, bounds: [48, 96, 864, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: formula-label
    elementType: text
    bounds: [48, 119, 450, 20]
    content: {fontSize: 11, color: "$teal", bold: true, letterSpacing: 1, wrap: false, text: "CONDITIONAL-LOGIT PROBABILITY"}
  - elementId: formula
    elementType: text
    bounds: [48, 151, 480, 60]
    content:
      fontSize: 28
      color: "$navy"
      align: [left, middle]
      text: |
        <p>\(p_{ri}=\frac{\exp(x_{ri}^{T}\beta)}{\sum_j\exp(x_{rj}^{T}\beta)}\)</p>
  - elementId: formula-note
    elementType: text
    bounds: [48, 235, 465, 42]
    content:
      fontSize: 16
      color: "$ink"
      lineHeight: 1.3
      text: "Exactly one winner; probabilities are constrained to sum to one within every race."
  - elementId: objective
    elementType: text
    bounds: [48, 288, 465, 73]
    content:
      fontSize: 15
      color: "$ink"
      lineHeight: 1.35
      text: |
        <p><strong>Fit:</strong> winner negative log likelihood + ridge penalty</p>
        <p><strong>Market benchmark:</strong> \(q_{ri}\propto 1/d_{ri}\)</p>
        <p><strong>Calibration:</strong> temperature fitted on validation only</p>
  - {elementId: method-divider, elementType: shape, bounds: [545, 122, 1, 238], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: candidates-label
