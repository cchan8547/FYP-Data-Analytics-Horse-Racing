pageType: content
background: {type: solid, color: "$paper"}
elements:
  - elementId: section
    elementType: text
    bounds: [48, 18, 420, 18]
    content: {fontSize: 10, color: "$teal", bold: true, letterSpacing: 1.2, wrap: false, text: "02 / OFFICIAL DATA + CHRONOLOGICAL DESIGN"}
  - elementId: timing
    elementType: text
    bounds: [850, 18, 62, 18]
    content: {fontSize: 11, color: "$grey", bold: true, align: [right, middle], wrap: false, text: "1:00"}
  - elementId: title
    elementType: text
    bounds: [48, 43, 830, 43]
    content: {style: "$title", wrap: false, text: "Five completed seasons, with a genuinely later test year"}
  - {elementId: header-rule, elementType: shape, bounds: [48, 96, 864, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: sample-races
    elementType: text
    bounds: [48, 119, 230, 46]
    content:
      fontSize: 35
      color: "$navy"
      bold: true
      wrap: false
      text: "4,207 races"
  - elementId: sample-starters
    elementType: text
    bounds: [48, 165, 240, 32]
    content: {fontSize: 20, color: "$teal", bold: true, wrap: false, text: "51,068 starters"}
  - elementId: sample-caption
    elementType: text
    bounds: [48, 204, 232, 42]
    content:
      fontSize: 14
      color: "$grey"
      lineHeight: 1.25
      text: "Final single-winner modeling sample at 440 result meetings"
  - {elementId: left-rule, elementType: shape, bounds: [48, 259, 218, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: split
    elementType: text
    bounds: [48, 276, 238, 116]
    content:
      fontSize: 15
      color: "$ink"
      lineHeight: 1.38
      text: |
        <p><strong>Train</strong> · 2021/22–2023/24</p>
        <p><strong>Validate / calibrate</strong> · 2024/25</p>
        <p><strong>Untouched test</strong> · 2025/26</p>
        <p><span style="color:$grey">Incomplete 2026/27 excluded</span></p>
  - elementId: audit
    elementType: text
    bounds: [48, 407, 236, 58]
    content:
      fontSize: 13
      color: "$ink"
      lineHeight: 1.3
      text: |
        <p><strong>Audit:</strong> 404 withdrawn rows removed; seven dead heats excluded from the single-winner likelihood.</p>
  - elementId: season-chart
    elementType: image
    bounds: [310, 116, 602, 351]
    src: "media/season_sample.png"
    fit: {mode: contain}
  - {elementId: footer-rule, elementType: shape, bounds: [48, 499, 864, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: source
    elementType: text
    bounds: [48, 507, 790, 18]
    content:
      style: "$source"
      wrap: false
      text: |
        <p>Source: <a href="https://racing.hkjc.com/en-us/local/information/archive/localresults">HKJC Local Results Archive</a>, accessed 19 Nov 2026; project sample audit and season_descriptives.csv.</p>
  - elementId: page-no
    elementType: text
    bounds: [874, 506, 38, 18]
    content: {fontSize: 10, color: "$grey", align: [right, middle], wrap: false, text: "03 / 14"}
