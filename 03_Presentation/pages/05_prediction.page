pageType: content
background: {type: solid, color: "$paper"}
elements:
  - elementId: section
    elementType: text
    bounds: [48, 18, 420, 18]
    content: {fontSize: 10, color: "$teal", bold: true, letterSpacing: 1.2, wrap: false, text: "04 / HELD-OUT PREDICTION"}
  - elementId: timing
    elementType: text
    bounds: [850, 18, 62, 18]
    content: {fontSize: 11, color: "$grey", bold: true, align: [right, middle], wrap: false, text: "1:15"}
  - elementId: title
    elementType: text
    bounds: [48, 43, 830, 43]
    content: {style: "$title", wrap: false, text: "Combined Logit matches the market on test log loss"}
  - {elementId: header-rule, elementType: shape, bounds: [48, 96, 864, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: primary-label
    elementType: text
    bounds: [48, 121, 220, 20]
    content: {fontSize: 10, color: "$teal", bold: true, letterSpacing: 1, wrap: false, text: "PRIMARY TRAINED MODEL"}
  - elementId: primary
    elementType: text
    bounds: [48, 150, 220, 65]
    content:
      fontSize: 29
      color: "$navy"
      bold: true
      lineHeight: 1.1
      text: |
        Combined
        Logit
  - elementId: test-label
    elementType: text
    bounds: [48, 234, 220, 18]
    content: {fontSize: 11, color: "$grey", bold: true, wrap: false, text: "TEST RACE LOG LOSS · LOWER IS BETTER"}
  - elementId: test-value
    elementType: text
    bounds: [48, 259, 220, 48]
    content: {fontSize: 39, color: "$teal", bold: true, wrap: false, text: "2.0318"}
  - elementId: market-value
    elementType: text
    bounds: [48, 307, 220, 26]
    content: {fontSize: 17, color: "$ink", wrap: false, text: "Market: 2.0321"}
  - elementId: top-one
    elementType: text
    bounds: [48, 345, 220, 50]
    content:
      fontSize: 15
      color: "$ink"
      lineHeight: 1.3
      text: |
        <p><strong>Top-one strike</strong></p>
        <p>29.35% vs market 28.65%</p>
  - {elementId: interpretation-rule, elementType: shape, bounds: [48, 411, 62, 4], shapeName: rect, fill: {type: solid, color: "$gold"}}
  - elementId: interpretation
    elementType: text
    bounds: [48, 428, 224, 48]
    content:
      fontSize: 14
      color: "$navy"
      bold: true
      lineHeight: 1.25
      text: "Validation market log loss = 1.9886, better than every trained candidate."
  - elementId: model-chart
    elementType: image
    bounds: [298, 116, 614, 358]
    src: "media/model_comparison.png"
    fit: {mode: contain}
  - {elementId: footer-rule, elementType: shape, bounds: [48, 499, 864, 1], shapeName: rect, fill: {type: solid, color: "#CFD8D5"}}
  - elementId: source
    elementType: text
    bounds: [48, 507, 790, 18]
    content: {style: "$source", wrap: false, text: "Source: model_metrics.csv. Test = 862 races / 10,760 runners in 2025/26; tuning and temperatures use validation only. Axis starts at 1.75."}
  - elementId: page-no
    elementType: text
    bounds: [874, 506, 38, 18]
    content: {fontSize: 10, color: "$grey", align: [right, middle], wrap: false, text: "05 / 14"}
