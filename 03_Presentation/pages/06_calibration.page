pageType: content
background: {type: solid, color: "$paper"}
elements:
  - elementId: section
    elementType: text
    bounds: [48, 18, 420, 18]
    content: {fontSize: 10, color: "$teal", bold: true, letterSpacing: 1.2, wrap: false, text: "04 / CALIBRATION + UNCERTAINTY"}
  - elementId: timing
